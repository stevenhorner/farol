<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release;Lite</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Lite|AnyCPU'">
    <DefineConstants>$(DefineConstants);LITE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <Content Include="seed.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Shop.Core/Shop.Core.csproj" />
  </ItemGroup>
</Project>
